# AWS Configuration for Pi-Mono Travel Agent
# Copy this file to .env and fill in your values

# Required: AWS region where Bedrock is available (e.g., us-east-1, us-west-2)
AWS_REGION=us-east-1

# Optional: Bedrock model identifier (defaults to us.anthropic.claude-sonnet-4-6 if not set).
# Use a cross-region inference profile id (us./eu./apac. prefix), not a bare model id.
MODEL_ID=us.anthropic.claude-sonnet-4-6

# Optional: AWS profile name from ~/.aws/credentials (uses default profile if not set)
AWS_PROFILE=default
